{
  "redirects": [
    {
      "source": "/repair/:path*",
      "destination": "/تعمیرات/لوازم-خانگی/:path*",
      "statusCode": 301
    },
    {
      "source": "/appliance/:path*",
      "destination": "/تعمیرات/لوازم-خانگی/:path*",
      "statusCode": 301
    },
    {
      "source": "/towtruck/:path*",
      "destination": "/خودروبر/:path*",
      "statusCode": 301
    },
    {
      "source": "/emdad-khodro/:path*",
      "destination": "/خودروبر/:path*",
      "statusCode": 301
    },
    {
      "source": "/scrap/:path*",
      "destination": "/ضایعات/عمده/:path*",
      "statusCode": 301
    },
    {
      "source": "/services/:path*",
      "destination": "/تعمیرات/لوازم-خانگی/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
