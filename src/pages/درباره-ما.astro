---
import Layout from '../layouts/Layout.astro';
import {
  PHONE_NUMBER,
  PHONE_INTL,
  SITE_NAME,
  SITE_URL,
  generateLocalBusinessSchema,
  generateBreadcrumbSchema,
} from '../utils/content';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  telephone: PHONE_INTL,
  founder: {
    '@type': 'Person',
    name: 'ابراهیم همتی',
  },
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'سمنان',
    addressCountry: 'IR',
  },
  areaServed: 'استان سمنان',
  openingHours: 'Mo-Su 00:00-23:59',
};

const localBusinessSchema = {
  ...generateLocalBusinessSchema(),
  founder: {
    '@type': 'Person',
    name: 'ابراهیم همتی',
  },
};

const schemas = [
  organizationSchema,
  localBusinessSchema,
  generateBreadcrumbSchema([
    { name: 'خانه', url: SITE_URL },
    { name: 'درباره ما', url: `${SITE_URL}/درباره-ما/` },
  ]),
];

const metaTitle = `درباره سمنان سرویس | خودروبر، جرثقیل و تعمیرات لوازم خانگی در استان سمنان`;
const metaDesc = `درباره سمنان سرویس - مرکز تخصصی خودروبر، یدک‌کش، جرثقیل و تعمیرات لوازم خانگی در استان سمنان. مدیر بخش خودروبر: آقای ابراهیم همتی. تماس: ${PHONE_NUMBER}`;
const canonical = `${SITE_URL}/درباره-ما/`;
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonical={canonical}
  schemas={schemas}
>
  <nav class="breadcrumb">
    <a href="/">خانه</a><span>›</span> درباره ما
  </nav>

  <h1>درباره سمنان سرویس | خودروبر، جرثقیل و تعمیرات لوازم خانگی در استان سمنان</h1>

  <div class="intro-section">
    <p>سمنان سرویس مرکز تخصصی ارائه خدمات خودروبر، یدک‌کش، جرثقیل امداد خودرو و تعمیرات لوازم خانگی در استان سمنان است. ما با سال‌ها تجربه و تیمی از متخصصان حرفه‌ای، در تمام ۲۲ شهر استان سمنان خدمات ۲۴ ساعته ارائه می‌دهیم. هدف ما ارائه خدمات سریع، باکیفیت و با قیمت منصفانه به ساکنین استان سمنان است.</p>
  </div>

  <div class="cta-box">
    <p>خودروبر و امداد خودرو — آقای ابراهیم همتی: <a href={`tel:${PHONE_NUMBER}`} data-ga="call_click">{PHONE_NUMBER}</a></p>
    <p style="margin-top: 8px;">تعمیرات لوازم خانگی — آقای تعمیر: <a href={`tel:${PHONE_NUMBER}`} data-ga="call_click">{PHONE_NUMBER}</a></p>
  </div>

  <h2>بخش خودروبر، یدک‌کش و جرثقیل امداد خودرو سمنان</h2>
  <p>بخش خودروبر و امداد خودرو سمنان سرویس با مدیریت <strong>آقای ابراهیم همتی</strong> فعالیت می‌کند. این بخش با مجوزهای مربوطه از اتحادیه و راهداری، خدمات تخصصی یدک‌کش سبک و سنگین، جرثقیل امداد خودرو، انتقال خودروهای سواری و سنگین، و امداد در جاده‌های بین‌شهری استان سمنان را ارائه می‌دهد.</p>
  <p>آقای ابراهیم همتی با سال‌ها تجربه در زمینه امداد خودرو و یدک‌کش، تیمی از رانندگان حرفه‌ای و یدک‌کش‌های مجهز را مدیریت می‌کند. تمام خدمات این بخش با مجوزهای قانونی اتحادیه و راهداری ارائه می‌شود و مشتریان می‌توانند با اطمینان کامل خدمات ما را دریافت کنند.</p>
  <p>برای درخواست امداد خودرو و یدک‌کش، با آقای ابراهیم همتی تماس بگیرید: <a href={`tel:${PHONE_NUMBER}`} data-ga="call_click">{PHONE_NUMBER}</a></p>

  <h2>بخش تعمیرات لوازم خانگی</h2>
  <p>بخش تعمیرات لوازم خانگی سمنان سرویس با مدیریت <strong>آقای تعمیر</strong> فعالیت می‌کند. این بخش شامل تعمیر تمام انواع لوازم خانگی از جمله یخچال فریزر، ماشین لباسشویی، ماشین ظرفشویی، کولر گازی، پکیج و آبگرمکن، تلویزیون، مایکروویو و جاروبرقی در تمام ۲۲ شهر استان سمنان است.</p>
  <p>آقای تعمیر با تیمی از تکنسین‌های متخصص و مجرب، خدمات تعمیر لوازم خانگی را با قطعات اصل و ضمانت ارائه می‌دهد. تمام تکنسین‌های این بخش دارای مدرک تخصصی و سال‌ها تجربه در تعمیر برندهای مختلف ایرانی و خارجی هستند.</p>
  <p>برای درخواست تعمیر لوازم خانگی، با آقای تعمیر تماس بگیرید: <a href={`tel:${PHONE_NUMBER}`} data-ga="call_click">{PHONE_NUMBER}</a></p>

  <h2>خدمات سمنان سرویس</h2>
  <ul>
    <li><strong>خودروبر و یدک‌کش:</strong> یدک‌کش سبک و سنگین در تمام شهرهای استان سمنان — مدیر: آقای ابراهیم همتی</li>
    <li><strong>جرثقیل امداد خودرو:</strong> خدمات جرثقیل برای خروج خودرو از شرایط سخت — مدیر: آقای ابراهیم همتی</li>
    <li><strong>امداد در جاده:</strong> امداد خودرو در جاده‌های بین‌شهری استان سمنان — مدیر: آقای ابراهیم همتی</li>
    <li><strong>تعمیر یخچال فریزر:</strong> تعمیر تمام برندهای یخچال با قطعات اصل — آقای تعمیر</li>
    <li><strong>تعمیر ماشین لباسشویی:</strong> تعمیر تمام برندهای لباسشویی — آقای تعمیر</li>
    <li><strong>تعمیر کولر گازی:</strong> شارژ گاز و تعمیر کولر گازی — آقای تعمیر</li>
    <li><strong>تعمیر پکیج و آبگرمکن:</strong> سرویس و تعمیر پکیج — آقای تعمیر</li>
    <li><strong>خرید ضایعات عمده:</strong> خرید لوازم اسقاطی و فلزی در استان سمنان</li>
  </ul>

  <h2>مجوزها و گواهینامه‌ها</h2>
  <p>سمنان سرویس با تمام مجوزهای قانونی لازم فعالیت می‌کند:</p>
  <ul>
    <li>مجوز اتحادیه یدک‌کش و خودروبر برای بخش امداد خودرو</li>
    <li>مجوز راهداری برای خدمات امداد در جاده‌های بین‌شهری</li>
    <li>مجوز اتحادیه تعمیرکاران لوازم خانگی برای بخش تعمیرات</li>
  </ul>

  <h2>تماس با سمنان سرویس</h2>
  <div class="cta-box">
    <p><strong>خودروبر و امداد خودرو — آقای ابراهیم همتی</strong></p>
    <a href={`tel:${PHONE_NUMBER}`} class="cta-phone" data-ga="call_click">{PHONE_NUMBER}</a>
    <p style="margin-top: 16px;"><strong>تعمیرات لوازم خانگی — آقای تعمیر</strong></p>
    <a href={`tel:${PHONE_NUMBER}`} class="cta-phone" data-ga="call_click">{PHONE_NUMBER}</a>
  </div>

  <div class="up-links">
    <p><a href="/">← بازگشت به صفحه اصلی</a></p>
  </div>
</Layout>
