---
import Layout from '../../../layouts/Layout.astro';
import { cities } from '../../../data/cities';
import {
  PHONE_NUMBER,
  SITE_NAME,
  SITE_URL,
  generateLocalBusinessSchema,
  generateBreadcrumbSchema,
  generateFAQSchema,
  type FaqItem,
} from '../../../utils/content';

const scrapFaqs: FaqItem[] = [
  {
    question: 'ضایعات عمده در استان سمنان چه نوع لوازمی را شامل می‌شود؟',
    answer: 'ضایعات عمده در استان سمنان شامل لوازم خانگی اسقاطی، فلزات آهنی و غیرآهنی، مس، آلومینیوم، لوازم بر قدیمی، موتور و قطعات خودرو، و سایر ضایعات فلزی و پلاستیکی است.',
  },
  {
    question: 'هزینه خرید ضایعات عمده در استان سمنان چگونه محاسبه می‌شود؟',
    answer: 'خرید ضایعات عمده در استان سمنان بر اساس وزن و نوع ماده محاسبه می‌شود. قیمت ضایعات فلزی روزانه تغییر می‌کند. برای اطلاع از قیمت روز با شماره تماس بگیرید.',
  },
  {
    question: 'آیا ضایعات را از محل جمع‌آوری می‌کنید؟',
    answer: `بله، برای مقادیر عمده، تیم ما در تمام شهرهای استان سمنان به محل شما اعزام می‌شود و ضایعات را جمع‌آوری می‌کند. با تماس با ${PHONE_NUMBER} درخواست خود را ثبت کنید.`,
  },
  {
    question: 'خرید ضایعات در کدام شهرهای استان سمنان فعال است؟',
    answer: 'خرید و جمع‌آوری ضایعات عمده در تمام ۲۲ شهر استان سمنان فعال است. از سمنان و شاهرود تا گرمسار و دامغان، تیم ما آماده جمع‌آوری ضایعات شماست.',
  },
];

const schemas = [
  generateLocalBusinessSchema(),
  generateBreadcrumbSchema([
    { name: 'خانه', url: SITE_URL },
    { name: 'ضایعات عمده', url: `${SITE_URL}/ضایعات/عمده/` },
  ]),
  generateFAQSchema(scrapFaqs),
];

const metaTitle = `ضایعات عمده در استان سمنان | خرید لوازم اسقاطی و فلزی | ${SITE_NAME}`;
const metaDesc = `خرید ضایعات عمده در استان سمنان. لوازم خانگی اسقاطی، فلزات آهنی و غیرآهنی، مس و آلومینیوم. جمع‌آوری از محل. تماس: ${PHONE_NUMBER}`;
const canonical = `${SITE_URL}/ضایعات/عمده/`;
const ogImage = `${SITE_URL}/images/featured/scrap-hub.webp`;
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonical={canonical}
  ogImage={ogImage}
  schemas={schemas}
>
  <nav class="breadcrumb">
    <a href="/">خانه</a><span>›</span> ضایعات عمده
  </nav>

  <h1>ضایعات عمده در استان سمنان</h1>

  <img
    src="/images/featured/scrap-hub.webp"
    alt="خرید ضایعات عمده در استان سمنان"
    class="featured-image"
    width="1200"
    height="675"
    loading="eager"
    fetchpriority="high"
  />

  <div class="intro-section">
    <p>خرید ضایعات عمده در استان سمنان یکی از خدمات {SITE_NAME} است. ما انواع ضایعات فلزی، لوازم خانگی اسقاطی، قطعات خودرو و سایر ضایعات را در تمام ۲۲ شهر استان سمنان خریداری می‌کنیم. خرید ضایعات نه تنها به شما کمک می‌کند فضای اشغال شده را آزاد کنید، بلکه به حفاظت از محیط زیست نیز کمک می‌کند.</p>

    <p>تیم ما در استان سمنان با قیمت روز و منصفانه، ضایعات عمده شما را خریداری می‌کند. برای مقادیر عمده، خدمات جمع‌آوری از محل در تمام شهرهای استان سمنان ارائه می‌شود. کافیست با شماره {PHONE_NUMBER} تماس بگیرید تا تیم ما به محل شما اعزام شود و ضایعات را ارزیابی و خریداری کند.</p>
  </div>

  <div class="cta-box">
    <p>برای فروش ضایعات عمده تماس بگیرید</p>
    <a href={`tel:${PHONE_NUMBER}`} class="cta-phone" data-ga="call_click">تماس فوری: {PHONE_NUMBER}</a>
  </div>

  <h2>انواع ضایعاتی که خریداری می‌کنیم</h2>
  <ul>
    <li><strong>لوازم خانگی اسقاطی:</strong> یخچال، ماشین لباسشویی، ماشین ظرفشویی، تلویزیون، مایکروویو و سایر لوازم خانگی خراب و اسقاطی.</li>
    <li><strong>فلزات آهنی:</strong> آهن، فولاد، ورق‌های فلزی، پروفیل و سایر فلزات آهنی.</li>
    <li><strong>فلزات غیرآهنی:</strong> مس، آلومینیوم، برنج، سرب و سایر فلزات غیرآهنی با قیمت بالا.</li>
    <li><strong>قطعات خودرو:</strong> موتور خراب، گیربکس، اگزوز و سایر قطعات خودرو اسقاطی.</li>
    <li><strong>لوازم بر قدیمی:</strong> کابل، موتور برق، پمپ آب و سایر لوازم بر قدیمی.</li>
    <li><strong>ضایعات پلاستیکی:</strong> انواع پلاستیک و پلیمر قابل بازیافت.</li>
  </ul>

  <h2>خرید ضایعات در شهرهای استان سمنان</h2>
  <div class="card-grid">
    {cities.map((city) => (
      <div class="card">
        <h3><a href={`/ضایعات/عمده/${city.slug}/`}>خرید ضایعات در {city.name}</a></h3>
        <p>جمع‌آوری و خرید ضایعات عمده در {city.name}</p>
      </div>
    ))}
  </div>

  <img
    src="/images/in-content/scrap-hub-incontent.webp"
    alt="جمع‌آوری ضایعات فلزی و لوازم خانگی اسقاطی در استان سمنان"
    class="in-content-image"
    width="800"
    height="600"
    loading="lazy"
  />

  <h2>چرا فروش ضایعات مهم است؟</h2>
  <p>فروش ضایعات به دلایل زیر مهم است:</p>
  <ul>
    <li><strong>حفاظت از محیط زیست:</strong> بازیافت فلزات و لوازم اسقاطی به حفظ منابع طبیعی و کاهش آلودگی کمک می‌کند.</li>
    <li><strong>درآمد اقتصادی:</strong> فروش ضایعات فلزی به ویژه مس و آلومینیوم می‌تواند درآمد خوبی داشته باشد.</li>
    <li><strong>آزاد کردن فضا:</strong> لوازم خانگی اسقاطی فضای زیادی اشغال می‌کنند و فروش آنها به آزاد شدن فضا کمک می‌کند.</li>
    <li><strong>جلوگیری از تجمع زباله:</strong> فروش ضایعات از تجمع زباله‌های فلزی و الکترونیکی در محیط زیست جلوگیری می‌کند.</li>
  </ul>

  <h2>قیمت ضایعات در استان سمنان</h2>
  <p>قیمت ضایعات در استان سمنان بسته به نوع ماده و قیمت روز بازار متغیر است:</p>
  <table class="issues-table">
    <thead>
      <tr><th>نوع ضایعات</th><th>واحد</th><th>قیمت حدودی</th></tr>
    </thead>
    <tbody>
      <tr><td>آهن قراضه</td><td>کیلوگرم</td><td>۸٬۰۰۰ تا ۱۵٬۰۰۰ تومان</td></tr>
      <tr><td>مس قراضه</td><td>کیلوگرم</td><td>۸۰٬۰۰۰ تا ۱۲۰٬۰۰۰ تومان</td></tr>
      <tr><td>آلومینیوم قراضه</td><td>کیلوگرم</td><td>۴۰٬۰۰۰ تا ۶۰٬۰۰۰ تومان</td></tr>
      <tr><td>برنج قراضه</td><td>کیلوگرم</td><td>۶۰٬۰۰۰ تا ۹۰٬۰۰۰ تومان</td></tr>
      <tr><td>لوازم خانگی اسقاطی</td><td>عدد</td><td>بسته به نوع و وزن</td></tr>
    </tbody>
  </table>

  <h2>سوالات متداول</h2>
  <div class="faq-section">
    {scrapFaqs.map((faq) => (
      <div class="faq-item">
        <h3>{faq.question}</h3>
        <p>{faq.answer}</p>
      </div>
    ))}
  </div>

  <div class="cta-box">
    <p>برای فروش ضایعات عمده در استان سمنان تماس بگیرید</p>
    <a href={`tel:${PHONE_NUMBER}`} class="cta-phone" data-ga="call_click">تماس فوری: {PHONE_NUMBER}</a>
  </div>

  <div class="up-links">
    <p><a href="/">← بازگشت به صفحه اصلی</a></p>
  </div>
</Layout>
