---
import Layout from '../../layouts/Layout.astro';
import { cities } from '../../data/cities';
import {
  PHONE_NUMBER,
  SITE_NAME,
  SITE_URL,
  generateLocalBusinessSchema,
  generateBreadcrumbSchema,
  generateFAQSchema,
  type FaqItem,
} from '../../utils/content';

const hubFaqs: FaqItem[] = [
  {
    question: 'امداد خودرو در استان سمنان چگونه کار می‌کند؟',
    answer: `با تماس با شماره ${PHONE_NUMBER}، نزدیک‌ترین یدک‌کش به محل شما در استان سمنان اعزام می‌شود. تیم ما در تمام ۲۲ شهر استان سمنان خدمات ۲۴ ساعته ارائه می‌دهد.`,
  },
  {
    question: 'هزینه یدک‌کش در استان سمنان چقدر است؟',
    answer: 'هزینه یدک‌کش بسته به مسافت و نوع خودرو متغیر است. قیمت پایه از ۳۰۰ هزار تومان شروع می‌شود. برای اطلاع از هزینه دقیق با شماره تماس بگیرید.',
  },
  {
    question: 'آیا امداد خودرو در جاده‌های بین‌شهری استان سمنان ارائه می‌شود؟',
    answer: 'بله، تیم امداد خودرو ما در تمام جاده‌های استان سمنان از جمله جاده سمنان-تهران، سمنان-شاهرود و سمنان-گرمسار خدمات ارائه می‌دهد.',
  },
  {
    question: 'امداد خودرو در چه ساعاتی فعال است؟',
    answer: 'خدمات امداد خودرو و یدک‌کش در تمام ۲۴ ساعت شبانه‌روز و ۷ روز هفته در استان سمنان فعال است.',
  },
];

const schemas = [
  generateLocalBusinessSchema(),
  generateBreadcrumbSchema([
    { name: 'خانه', url: SITE_URL },
    { name: 'خودروبر و امداد خودرو', url: `${SITE_URL}/خودروبر/` },
  ]),
  generateFAQSchema(hubFaqs),
];

const metaTitle = `خودروبر و امداد خودرو در استان سمنان | یدک‌کش ۲۴ ساعته | ${SITE_NAME}`;
const metaDesc = `خودروبر و امداد خودرو در استان سمنان. یدک‌کش فوری در تمام ۲۲ شهر استان. خدمات ۲۴ ساعته در جاده‌ها و شهرها. تماس: ${PHONE_NUMBER}`;
const canonical = `${SITE_URL}/خودروبر/`;
const ogImage = `${SITE_URL}/images/featured/towtruck-hub.webp`;
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonical={canonical}
  ogImage={ogImage}
  schemas={schemas}
  contactName="آقای ابراهیم همتی"
>
  <nav class="breadcrumb">
    <a href="/">خانه</a><span>›</span> خودروبر و امداد خودرو
  </nav>

  <h1>خودروبر و امداد خودرو در استان سمنان</h1>

  <img
    src="/images/featured/towtruck-hub.webp"
    alt="خودروبر و امداد خودرو در استان سمنان"
    class="featured-image"
    width="1200"
    height="675"
    loading="eager"
    fetchpriority="high"
  />

  <div class="intro-section">
    <p>خودروبر و امداد خودرو یکی از خدمات حیاتی {SITE_NAME} در استان سمنان است. با وسعت بیش از ۹۷ هزار کیلومتر مربع و جاده‌های طولانی بین شهری، خرابی خودرو در استان سمنان می‌تواند به یک مشکل جدی تبدیل شود. تیم امداد خودرو ما با یدک‌کش‌های مجهز و رانندگان حرفه‌ای، در تمام ۲۲ شهر استان سمنان و جاده‌های بین‌شهری خدمات ۲۴ ساعته ارائه می‌دهد.</p>

    <p>اعزام خودروبر در استان سمنان شامل یدک‌کش سبک و سنگین، انتقال خودروهای سواری و وانت، امداد در جاده برای تعویض لاستیک، سوخت‌رسانی، باتری‌Boost و راه‌اندازی اضطراری است. با تماس با شماره {PHONE_NUMBER}، نزدیک‌ترین یدک‌کش به محل شما در استان سمنان در کمترین زمان ممکن اعزام می‌شود. ما در تمام جاده‌های استان از جمله جاده سمنان-تهران، سمنان-شاهرود، سمنان-گرمسار و دامغان-شاهرود حاضر هستیم.</p>

    <p>خدمات امداد خودرو ما در استان سمنان شامل موارد زیر است: یدک‌کش فوری در داخل شهرها، امداد در جاده‌های بین‌شهری، انتقال خودرو به تعمیرگاه، تعویض لاستیک اضطراری، سوخت‌رسانی در جاده، باتری‌Boost و راه‌اندازی اضطراری، و خروج خودرو از گودال و شرایط سخت جاده‌ای. تمام خدمات با قیمت منصفانه و در سریع‌ترین زمان ممکن ارائه می‌شود.</p>
  </div>

  <div class="cta-box">
    <p>نیاز به امداد فوری خودرو دارید؟</p>
    <a href={`tel:${PHONE_NUMBER}`} class="cta-phone" data-ga="call_click">تماس فوری: {PHONE_NUMBER}</a>
  </div>

  <h2>خدمات امداد خودرو و خودروبر در استان سمنان</h2>
  <p>تیم امداد خودرو {SITE_NAME} در استان سمنان طیف کاملی از خدمات roadside assistance را ارائه می‌دهد:</p>
  <ul>
    <li><strong>یدک‌کش فوری:</strong> اعزام یدک‌کش سبک و سنگین برای انتقال خودروهای سواری، وانت و ون در تمام شهرهای استان سمنان.</li>
    <li><strong>امداد در جاده:</strong> امداد خودرو در جاده‌های بین‌شهری استان سمنان برای رفع خرابی‌های جزئی، تعویض لاستیک و سوخت‌رسانی.</li>
    <li><strong>باتری‌Boost:</strong> راه‌اندازی اضطراری خودرو در صورت خالی شدن باتری در تمام مناطق استان سمنان.</li>
    <li><strong>تعویض لاستیک اضطراری:</strong> تعویض لاستیک پنچر شده در محل با تکنسین‌های مجرب در استان سمنان.</li>
    <li><strong>سوخت‌رسانی:</strong> رساندن سوقت اضطراری به خودروهای متوقف شده در جاده‌های استان سمنان.</li>
    <li><strong>خروج از گودال:</strong> کمک به خروج خودرو از گودال، شن و ماسه یا شرایط سخت جاده‌ای در استان سمنان.</li>
    <li><strong>انتقال به تعمیرگاه:</strong> انتقال خودرو خراب به تعمیرگاه مورد نظر شما در استان سمنان یا شهرهای مجاور.</li>
  </ul>

  <h2>امداد خودرو در شهرهای استان سمنان</h2>
  <p>ما در تمام ۲۲ شهر استان سمنان خدمات امداد خودرو و یدک‌کش ارائه می‌دهیم. روی شهر خود کلیک کنید:</p>
  <div class="card-grid">
    {cities.map((city) => (
      <div class="card">
        <h3><a href={`/خودروبر/${city.slug}/`}>امداد خودرو در {city.name}</a></h3>
        <p>{city.callout}</p>
      </div>
    ))}
  </div>

  <img
    src="/images/in-content/towtruck-hub-incontent.webp"
    alt="یدک‌کش و امداد خودرو در جاده‌های استان سمنان"
    class="in-content-image"
    width="800"
    height="600"
    loading="lazy"
  />

  <h2>جاده‌های تحت پوشش امداد خودرو در استان سمنان</h2>
  <p>استان سمنان دارای جاده‌های طولانی و مهمی است که تیم امداد خودرو ما در تمام آنها حاضر است:</p>
  <ul>
    <li><strong>جاده سمنان-تهران:</strong> یکی از پرترددترین جاده‌های استان که امداد خودرو در تمام مسیر آن ارائه می‌شود.</li>
    <li><strong>جاده سمنان-شاهرود:</strong> مسیر شرق استان با طول بیش از ۲۰۰ کیلومتر که امداد خودرو در تمام نقاط آن فعال است.</li>
    <li><strong>جاده سمنان-گرمسار:</strong> مسیر غرب استان به سمت تهران که امداد خودرو در آن ارائه می‌شود.</li>
    <li><strong>جاده دامغان-شاهرود:</strong> مسیر شرقی استان با امداد خودرو ۲۴ ساعته.</li>
    <li><strong>جاده گرمسار-ایوانکی:</strong> مسیر غربی استان که امداد خودرو در آن فعال است.</li>
    <li><strong>جاده مهدی‌شهر-سمنان:</strong> مسیر کوهستانی استان که امداد خودرو در آن ارائه می‌شود.</li>
  </ul>

  <h2>هزینه امداد خودرو و یدک‌کش در استان سمنان</h2>
  <p>هزینه امداد خودرو در استان سمنان بسته به نوع خدمات و مسافت متغیر است:</p>
  <table class="issues-table">
    <thead>
      <tr>
        <th>نوع خدمت</th>
        <th>محدوده قیمت</th>
        <th>زمان رسیدن</th>
      </tr>
    </thead>
    <tbody>
      <tr><td>یدک‌کش در داخل شهر</td><td>۳۰۰٬۰۰۰ تا ۵۰۰٬۰۰۰ تومان</td><td>کمتر از ۱ ساعت</td></tr>
      <tr><td>یدک‌کش بین شهری</td><td>۵۰۰٬۰۰۰ تا ۱٬۵۰۰٬۰۰۰ تومان</td><td>بسته به مسافت</td></tr>
      <tr><td>باتری‌Boost</td><td>۱۵۰٬۰۰۰ تا ۳۰۰٬۰۰۰ تومان</td><td>کمتر از ۴۵ دقیقه</td></tr>
      <tr><td>تعویض لاستیک اضطراری</td><td>۱۰۰٬۰۰۰ تا ۲۵۰٬۰۰۰ تومان</td><td>کمتر از ۴۵ دقیقه</td></tr>
      <tr><td>سوفت‌رسانی</td><td>۲۰۰٬۰۰۰ تا ۴۰۰٬۰۰۰ تومان</td><td>کمتر از ۱ ساعت</td></tr>
    </tbody>
  </table>

  <h2>مراحل درخواست امداد خودرو در استان سمنان</h2>
  <ol>
    <li><strong>تماس:</strong> با شماره {PHONE_NUMBER} تماس بگیرید و محل دقیق خود را اعلام کنید.</li>
    <li><strong>اعزام یدک‌کش:</strong> نزدیک‌ترین یدک‌کش به محل شما در استان سمنان اعزام می‌شود.</li>
    <li><strong>امداد:</strong> راننده امداد به محل شما می‌رسد و خودرو شما را امداد یا انتقال می‌دهد.</li>
    <li><strong>پرداخت:</strong> هزینه خدمات پس از انجام کار به صورت نقدی یا کارتی پرداخت می‌شود.</li>
  </ol>

  <h2>توصیه‌های ایمنی در صورت خرابی خودرو در جاده</h2>
  <ul>
    <li>خودرو را به حاشیه جاده منتقل کنید و مثلث هشدار را در فاصله مناسب قرار دهید.</li>
    <li>چراغ‌های اضطراری (هزرده) را روشن کنید تا سایر رانندگان شما را ببینند.</li>
    <li>در داخل خودرو بمانید و درب‌ها را قفل کنید، مخصوصاً در جاده‌های خلوت استان سمنان.</li>
    <li>بلافاصله با شماره {PHONE_NUMBER} تماس بگیرید و محل دقیق خود را اعلام کنید.</li>
    <li>در صورت امکان، کیلومتر جاده و شهر نزدیک را به اپراتور اعلام کنید.</li>
  </ul>

  <h2>منابع و مراجع</h2>
  <p>برای آشنایی با خدمات امداد خودرو در سایر مناطق ایران، می‌توانید به <a href="https://www.service-sos.ir/یدک-کش-خودرو-فوری-در-قرچک/" rel="noopener" target="_blank" class="external-link">یدک کش فوری در قرچک</a> مراجعه کنید. همچنین برای اطلاع از پوشش ملی خدمات امداد خودرو، <a href="https://www.hamyar-khodro.ir/emdad-khodro-shiraz" rel="noopener" target="_blank" class="external-link">امداد خودرو و یدک کش شیراز</a> منبع مفیدی است.</p>

  <h2>سوالات متداول</h2>
  <div class="faq-section">
    {hubFaqs.map((faq) => (
      <div class="faq-item">
        <h3>{faq.question}</h3>
        <p>{faq.answer}</p>
      </div>
    ))}
  </div>

  <div class="cta-box">
    <p>برای امداد فوری خودرو در استان سمنان تماس بگیرید</p>
    <a href={`tel:${PHONE_NUMBER}`} class="cta-phone" data-ga="call_click">تماس فوری: {PHONE_NUMBER}</a>
  </div>

  <div class="up-links">
    <p><a href="/">← بازگشت به صفحه اصلی</a></p>
  </div>
</Layout>
